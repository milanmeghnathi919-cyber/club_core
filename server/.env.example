NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# =============================================================================
# POSTGRES  ->  Dashboard > Connect > Direct connection
# Plain TCP to port 5432. This is the only database config the app uses.
# Remote connections require TLS, so keep DB_SSL=true.
# =============================================================================
DB_HOST=db.YOUR-PROJECT-REF.supabase.co
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=PASTE_DB_PASSWORD_HERE
DB_POOL_MAX=10
DB_SSL=true

# =============================================================================
# AUTH   ->  generate with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# =============================================================================
JWT_SECRET=PASTE_GENERATED_SECRET_HERE
JWT_EXPIRES_IN=1d

# =============================================================================
# CLOUDINARY
# =============================================================================
CLOUDINARY_CLOUD_NAME=YOUR-CLOUD-NAME
CLOUDINARY_API_KEY=YOUR-CLOUDINARY-API-KEY
CLOUDINARY_API_SECRET=YOUR-CLOUDINARY-API-SECRET
CLOUDINARY_FOLDER=clubhouse

# =============================================================================
# UPLOADS (multer)
# =============================================================================
UPLOAD_MAX_MB=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif

# =============================================================================
# SMTP (nodemailer)   leave SMTP_HOST blank to disable sending
# =============================================================================
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com

# =============================================================================
# RAZORPAY
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=