NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173

# --- Supabase -----------------------------------------------------------------
# Project Settings > API. Use the service_role key; never ship it to the browser.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_ANON_KEY=your-anon-key

# --- Auth ---------------------------------------------------------------------
JWT_SECRET=replace-with-a-long-random-string
JWT_EXPIRES_IN=1d

# --- Cloudinary ---------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret
CLOUDINARY_FOLDER=clubhouse

# --- Uploads ------------------------------------------------------------------
UPLOAD_MAX_MB=5
UPLOAD_ALLOWED_TYPES=image/jpeg,image/png,image/webp,image/avif

# --- SMTP (nodemailer) --------------------------------------------------------
# Leave SMTP_HOST blank to disable email; senders log and skip instead of failing.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=no-reply@example.com

# --- Razorpay -----------------------------------------------------------------
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=