NODE_ENV=development
PORT=5000
CLIENT_ORIGIN=http://localhost:5173
CLIENT_URL=http://localhost:5173

# =============================================================================
# POSTGRES -> Direct connection (Supabase)
# Plain TCP to port 5432. Remote connections require TLS (DB_SSL=true).
# =============================================================================
# Supabase Pooler (IPv4 / IPv6 compatible)
DB_HOST=aws-0-ap-southeast-1.pooler.supabase.com
DB_PORT=5432
DB_NAME=postgres
DB_USER=postgres.rcfyaquqdrvlwyvfshow
DB_PASSWORD=club_core@123
DB_POOL_MAX=10
DB_SSL=true

# =============================================================================
# AUTH
# =============================================================================
JWT_SECRET=development-secret-key-at-least-32-characters-long
JWT_EXPIRES_IN=7d
COOKIE_SECURE=false

# =============================================================================
# EMAIL -> Google Application Pass Key
#
# EMAIL_PASS must be the 16-character Google App Password (pass key),
# NOT your account password. Generate at https://myaccount.google.com/apppasswords
# (Requires 2-Step Verification enabled). Spaces are stripped automatically.
# =============================================================================
EMAIL_USER=your-gmail-address@gmail.com
EMAIL_PASS=your-16-char-google-pass-key

# =============================================================================
# CLOUDINARY (Optional for photo uploads)
# =============================================================================
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_FOLDER=clubhouse

# =============================================================================
# RAZORPAY (Optional for payments)
# =============================================================================
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

JOB_SECRET=local-dev-job-secret
CLUB_TZ=Asia/Kolkata
