{
  "name": "server",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "src/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "node --env-file-if-exists=.env --watch src/server.js",
    "start": "node --env-file-if-exists=.env src/server.js",
    "db:migrate": "node --env-file-if-exists=.env src/db/migrate.js",
    "db:check": "node --env-file-if-exists=.env src/scripts/checkConnections.js",
    "lint": "eslint .",
    "db:test": "node --env-file-if-exists=.env src/scripts/testConnection.js",
    "db:smoke": "node --env-file-if-exists=.env src/scripts/smokeTest.js"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cloudinary": "^2.11.0",
    "compression": "^1.7.4",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "morgan": "^1.10.0",
    "multer": "^2.4.0",
    "nodemailer": "^10.0.13",
    "pg": "^8.23.1",
    "razorpay": "^2.9.8"
  },
  "devDependencies": {
    "eslint": "^9.10.0"
  }
}
